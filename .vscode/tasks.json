{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Install deps",
      "type": "shell",
      "command": "cd backend && python -m venv .venv && .venv/bin/pip install -r requirements.txt",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "Backend: Run dev",
      "type": "shell",
      "command": "cd backend && ../.venv/bin/uvicorn app.main:app --reload --port 8000",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Frontend: Install deps",
      "type": "shell",
      "command": "cd frontend && npm install",
      "group": "build"
    },
    {
      "label": "Frontend: Run dev",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Frontend: Build",
      "type": "shell",
      "command": "cd frontend && npm run build",
      "group": "build"
    },
    {
      "label": "Docker: Up",
      "type": "shell",
      "command": "docker compose up -d",
      "group": "build"
    },
    {
      "label": "Docker: Logs",
      "type": "shell",
      "command": "docker compose logs -f",
      "group": "test"
    }
  ]
}
