# ─── Telegram ─────────────────────────────────────────────────────────────
BOT_TOKEN=7xxxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEBAPP_URL=https://your-domain.com

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=***
SUPABASE_SERVICE_ROLE_KEY=***

# ─── N8n ──────────────────────────────────────────────────────────────────
N8N_HOST=n8n.your-domain.com
N8N_USER=admin
N8N_PASSWORD=strong_password_here
N8N_ENCRYPTION_KEY=random_32_char_string_here
N8N_API_KEY=n8n_api_key_from_settings

# ─── Backend ──────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
CORS_ORIGINS=https://your-domain.com,https://t.me

# ─── Meta / Instagram ─────────────────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token
